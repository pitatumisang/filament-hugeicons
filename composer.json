{
    "name": "vendor/filament-hugeicons",
    "description": "Hugeicons integration for Filament with optional default icon replacement",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.16",
        "afatmustafa/blade-hugeicons": "*"
    },
    "autoload": {
        "psr-4": {
            "Vendor\\FilamentHugeicons\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vendor\\FilamentHugeicons\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vendor\\FilamentHugeicons\\FilamentHugeiconsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0 || ^4.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
