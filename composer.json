{
    "name": "enigmainc/filament-hugeicons",
    "description": "Hugeicons integration for Filament with optional default icon replacement",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.16",
        "afatmustafa/blade-hugeicons": "2.1.0"
    },
    "autoload": {
        "psr-4": {
            "EnigmaInc\\FilamentHugeicons\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EnigmaInc\\FilamentHugeicons\\Tests\\": "tests/",
            "EnigmaInc\\FilamentHugeicons\\Development\\": "scripts/Support/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EnigmaInc\\FilamentHugeicons\\FilamentHugeiconsServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "pint",
        "format": "@lint",
        "refactor": "rector",
        "test": "pest",
        "test:arch": "pest --group=arch",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run",
        "check": [
            "@test:composer",
            "@icons:check",
            "@test:lint",
            "@test:refactor",
            "@analyse",
            "@test"
        ],
        "icons:generate": "@php scripts/generate-icons.php",
        "icons:check": "@php scripts/generate-icons.php --check",
        "test:composer": "@composer validate --strict --no-check-lock --no-check-all"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0 || ^4.0",
        "pestphp/pest-plugin-arch": "^3.0 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    }
}
